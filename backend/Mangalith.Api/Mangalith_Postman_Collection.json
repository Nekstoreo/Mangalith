		{
			"name": "File Management",
			"item": [
				{
					"name": "Upload File",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('fileId', response.fileId);",
									"    if (response.publicationId) {",
									"        pm.collectionVariables.set('publicationId', response.publicationId);",
									"    }",
									"    if (response.mangaId) {",
									"        pm.collectionVariables.set('mangaId', response.mangaId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "test-files/sample.cbr"
								},
								{
									"key": "title",
									"value": "Test Manga Title",
									"type": "text"
								},
								{
									"key": "description",
									"value": "This is a test manga upload",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/files/upload",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"files",
								"upload"
							]
						}
					}
				},
				{
					"name": "Get File",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/files/{{fileId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"files",
								"{{fileId}}"
							]
						}
					}
				}
			]
		},
